    {
      "name": "17 - Workout Status (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code esperado', function () {",
              "  pm.expect([200, 401, 403, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Retorno possui status valido', function () {",
              "    pm.expect(['processing', 'done', 'error']).to.include(data.status);",
              "  });",
              "  pm.test('Retorno traz result quando done', function () {",
              "    if (data.status === 'done') {",
              "      pm.expect(data.result).to.be.an('object');",
              "      pm.expect(data.result).to.have.property('workout_plan');",
              "    } else {",
              "      pm.expect(data.result).to.eql(null);",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{tenant_host}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/workouts/status/{{workout_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "workouts",
            "status",
            "{{workout_id}}"
          ]
        }
      }
