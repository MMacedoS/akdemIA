    {
      "name": "02 - Register Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code esperado', function () {",
              "  pm.expect([201, 422]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "  let data = null;",
              "  try {",
              "    data = pm.response.json();",
              "  } catch (e) {",
              "    pm.test('Resposta deve ser JSON valido', function () {",
              "      throw new Error('Resposta nao e JSON. Host atual: ' + pm.request.headers.get('Host') + '. Body: ' + pm.response.text());",
              "    });",
              "  }",
              "  if (!data) {",
              "    return;",
              "  }",
              "",
              "  pm.test('Cadastro retorna estudante standalone autenticado', function () {",
              "    pm.expect(data).to.have.property('authenticated', true);",
              "    pm.expect(data).to.have.property('profile', 'student');",
              "    pm.expect(data).to.have.property('requiresTenantSelection', false);",
              "    pm.expect(data).to.have.property('token').that.is.a('string').and.not.empty;",
              "    pm.expect(data).to.have.nested.property('policies.accepted', true);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Host",
            "value": "{{app_host}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aluno App {{$timestamp}}\",\n  \"email\": \"aluno+{{$timestamp}}@akademia.test\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\",\n  \"terms_of_use\": true,\n  \"privacy_policy\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "03 - Login (Sem Subdominio)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code esperado', function () {",
              "  pm.expect([200, 403, 422]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "  let data = null;",
              "  try {",
              "    data = pm.response.json();",
              "  } catch (e) {",
              "    pm.test('Resposta deve ser JSON valido', function () {",
              "      throw new Error('Resposta nao e JSON. Host atual: ' + pm.request.headers.get('Host') + '. Body: ' + pm.response.text());",
              "    });",
              "  }",
              "  if (!data) {",
              "    return;",
              "  }",
              "",
              "  pm.test('Retorno sem subdominio respeita o fluxo atual de autenticacao', function () {",
              "    pm.expect(data).to.have.property('policies').that.is.an('object');",
              "    if (data.requiresTenantSelection === true) {",
              "      pm.expect(data).to.have.property('selectionToken').that.is.a('string').and.not.empty;",
              "      pm.expect(data).to.have.property('tenants').that.is.an('array').and.not.empty;",
              "      return;",
              "    }",
              "",
              "    pm.expect(data).to.have.property('authenticated', true);",
              "    pm.expect(data).to.have.property('token').that.is.a('string').and.not.empty;",
              "  });",
              "",
              "  if (data.selectionToken) {",
              "    pm.collectionVariables.set('selection_token', data.selectionToken);",
              "  }",
              "",
              "  if (Array.isArray(data.tenants) && data.tenants.length > 0 && data.tenants[0].id) {",
              "    pm.collectionVariables.set('tenant_id', String(data.tenants[0].id));",
              "    if (data.tenants[0].slug) {",
              "      pm.collectionVariables.set('tenant_host', data.tenants[0].slug + '.' + pm.collectionVariables.get('root_domain'));",
              "    }",
              "  }",
              "",
              "  if (data.tenant && data.tenant.id) {",
              "    pm.collectionVariables.set('tenant_id', String(data.tenant.id));",
              "    if (data.tenant.slug) {",
              "      pm.collectionVariables.set('tenant_host', data.tenant.slug + '.' + pm.collectionVariables.get('root_domain'));",
              "    }",
              "  }",
              "",
              "  if (data.token) {",
              "    pm.collectionVariables.set('token', data.token);",
              "    if (data.requiresTenantSelection !== true) {",
              "      pm.collectionVariables.set('tenant_host', pm.collectionVariables.get('app_host'));",
              "    }",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Host",
            "value": "{{app_host}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
